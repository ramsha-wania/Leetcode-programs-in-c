int longestValidParentheses(char* s) {
    int stack[30001];
    int top = -1;
    int max = 0;

    stack[++top] = -1;

    for (int i = 0; s[i] != '\0'; i++) {

        if (s[i] == '(') {
            stack[++top] = i;
        }
        else {
            top--;

            if (top == -1) {
                stack[++top] = i;
            }
            else {
                int length = i - stack[top];

                if (length > max)
                    max = length;
            }
        }
    }

    return max;
}
